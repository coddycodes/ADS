{
  "name": "coddy-studio",
  "version": "0.11.0",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/run-msvc.mjs cargo build -p coddy-studio-server",
    "dev": "node ../../scripts/run-msvc.mjs cargo run -p coddy-studio-server --bin coddy-studio -- serve --no-browser",
    "start": "node ../../scripts/run-msvc.mjs cargo run -p coddy-studio-server --bin coddy-studio --",
    "test": "node ../../scripts/run-msvc.mjs cargo test -p coddy-studio-server -j 2",
    "typecheck": "node ../../scripts/run-msvc.mjs cargo check -p coddy-studio-server --all-targets"
  }
}
