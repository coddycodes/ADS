{
  "name": "@coddy/marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --require ../../scripts/disable-telemetry.cjs ./node_modules/astro/bin/astro.mjs dev",
    "build": "node --require ../../scripts/disable-telemetry.cjs ./node_modules/astro/bin/astro.mjs build",
    "preview": "node --require ../../scripts/disable-telemetry.cjs ./node_modules/astro/bin/astro.mjs preview",
