  "settings-diagnostics-panel": [
    {
      "state": "trace-summary",
      "actions": [
        {
          "action": "scrollIntoView",
          "selector": "span.min-w-0.truncate",
          "text": "Spans"
        }
      ],
      "owners": ["StatBlock", "DiagnosticsLastChecked", "DiagnosticsSettingsPanel"],
      "visible_text": ["Spans", "Checked"]
    },
    {
      "state": "failures",
      "actions": [
        {
          "action": "scrollIntoView",
          "text": "Latest Failures"
        }
      ],
      "owners": ["ExpandableText", "DiagnosticsTable"],
      "visible_text": ["Show full error", "fixture.trace.failed"]
    },
    {
      "state": "full-error",
      "actions": [
        {
          "action": "click",
          "role": "button",
          "name": "Show full error",
          "index": 0,
          "selector": "button"
        }
      ],
      "owners": ["ExpandableText"],
      "visible_text": ["Show less"]
    },
    {
      "state": "slow-spans",
      "actions": [
        {
          "action": "scrollIntoView",
          "text": "Slowest Spans"
        }
      ],
      "owners": ["DiagnosticsTable"],
      "visible_text": ["fixture.trace.slow"]
    },
    {
      "state": "trace-id",
      "actions": [
        {
          "action": "scrollIntoView",
          "selector": "span.font-mono.text-xs",
          "text": "trace-0123456789ab...vwxyz-9876",
          "index": 0
        }
      ],
      "owners": ["TraceIdCell"],
      "visible_text": ["trace-0123456789ab...vwxyz-9876"],
      "note": "Reveal the actual right-hand Trace column through its scroller; the name/table witness remains in slow-spans."
    }
  ],
  "settings-keybindings": [
    {
      "state": "row",
      "actions": [],
      "owners": ["KeybindingTableRow", "KeybindingsSettingsPanel"],
      "visible_text": ["Terminal: Split"]
    },
    {
      "state": "expanded-search",
      "actions": [
        {
          "action": "click",
          "role": "button",
          "name": "Search keybindings",
          "selector": "button"
        }
      ],
      "owners": ["ExpandableHeaderSearch"],
      "visible_text": ["Search keybindings"],
      "note": "The search placeholder is emitted by the actual input; a nonempty query keeps the header input open after blur."
    },
    {
      "state": "condition-tree",
      "actions": [
        {
          "action": "click",
          "role": "button",
          "name": "Edit when clause for Terminal: Split",
          "selector": "button"
        }
      ],
      "owners": ["WhenExpressionBuilder", "WhenExpressionNodeEditor"],
      "visible_text": ["When", "Condition", "Group", "Not"]
    },
    {
      "state": "parse-error",
      "actions": [
        {
          "action": "fill",
          "role": "textbox",
          "name": "When expression",
          "value": "terminalFocus && (",
          "selector": "input[aria-label=\"When expression\"]"
        }
      ],
      "owners": ["WhenExpressionBuilder"],
      "visible_text": ["Use variables with !, &&, ||, and parentheses."]
    },
    {
      "state": "shortcut-edit-copy",
      "actions": [
        {
          "action": "fill",
          "role": "textbox",
          "name": "When expression",
          "value": "terminalFocus && (!composerFocus || threadFocus)",
          "selector": "input[aria-label=\"When expression\"]"
        },
        {
          "action": "escape"
        },
        {
          "action": "focus",
          "role": "button",
          "name": "Edit shortcut for Terminal: Split",
          "selector": "button"
        }
      ],
      "owners": ["KeybindingTableRow"],
      "visible_text": ["Edit"],
      "note": "Restore the original fixture clause through the real expression input before closing; incremental invalid typing leaves a dirty row and hides the shortcut pill."
    }
  ],
