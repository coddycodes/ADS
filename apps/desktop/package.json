{
  "name": "@bibcode/desktop",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-msvc.mjs pnpm exec tauri dev -- -p bibcode-desktop",
    "build": "node ../../scripts/run-tauri-build.mjs",
    "bundle": "node ../../scripts/run-tauri-build.mjs bundle",
    "typecheck": "node ../../scripts/run-msvc.mjs cargo check -p bibcode-desktop && tsc --noEmit -p e2e/tsconfig.json",
    "test": "node ../../scripts/run-msvc.mjs cargo test -p bibcode-desktop -j 2",
    "test:ui": "wdio run ./e2e/wdio.conf.ts",
    "test:ui:build": "node ./e2e/support/build-packaged-app.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@wdio/cli": "9.29.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/native-utils": "2.5.0",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/tauri-service": "1.2.0",
    "webdriverio": "9.29.1"
  },
  "productName": "BiBCode"
}
