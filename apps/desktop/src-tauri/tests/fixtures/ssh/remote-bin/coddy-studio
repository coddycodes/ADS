#!/bin/sh
# CODDY_STUDIO-SSH-FIXTURE remote `coddy-studio` wrapper for tests/ssh_environment.rs.
# Logs its argv, refuses a bare invocation (the real CLI would start a
# foreground server on 127.0.0.1:3773), optionally hangs on `pairing`, and
# otherwise runs the real native binary unchanged.
state="${SSH_FIXTURE_STATE:-}"
if [ -n "$state" ]; then
  {
    printf 'pid=%s argc=%s argv:' "$$" "$#"
    for arg in "$@"; do printf ' [%s]' "$arg"; done
    printf '\n'
  } >>"$state/remote-coddy-studio.log" 2>/dev/null || true
fi
if [ "$#" -eq 0 ]; then
  printf 'fixture: remote ran `coddy-studio` with no arguments; the real CLI would start a foreground server on 127.0.0.1:3773 instead of issuing a pairing credential\n' >&2
  exit 97
fi
if [ "$1" = "pairing" ] && [ "${SSH_FIXTURE_HANG_PAIRING:-0}" = "1" ]; then
  if [ -n "$state" ]; then
    printf '%s\n' "$$" >>"$state/hang.pid"
  fi
  exec sleep 600
fi
exec "$SSH_FIXTURE_CODDY_STUDIO" "$@"
