<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Remote Coddy Studio servers are user-chosen plain-HTTP endpoints on a trusted
	  private network (LAN or tailnet), reached from the webview. Host identity is
	  pinned and the RPC channel is encrypted (Noise NK) on top of that transport,
	  so App Transport Security is relaxed for web content only; native code keeps
	  the default policy.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Coddy Studio connects to Coddy Studio servers you pair with on your local network or tailnet.</string>
</dict>
</plist>
